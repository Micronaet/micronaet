<?xml version="1.0"?>
<openerp>
    <data>
        <record model="ir.ui.view" id="default_mrp_production_custom_bom_form_view">
            <field name="name">Production custom BOM</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view" />
            <field name="arch" type="xml">
                <field name="bom_id" position="attributes">
                    <attribute name="context">{'origin_bom_id': origin_bom_id}</attribute>
                </field>
            </field>
        </record>
        <record model="ir.ui.view" id="view_mrp_bom_obsolete_search">
            <field name="name">mrp.bom.obsoletesearch</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.view_mrp_bom_filter"/>
            <field name="arch" type="xml">
               <field name="name" position="after">
                   <filter string="Obsolete" domain="[('obsolete', '=', True)]]" />
                   <filter string="In uso" domain="[('obsolete', '=', False)]]" />
               </field>
               <filter string="Product" position="after">
                   <filter string="Obsolete" context="{'group_by': 'obsolete'}" />
               </filter>
            </field>
        </record>

        <record model="ir.ui.view" id="view_mrp_bom_last_bom_use_tree">
            <field name="name">mrp.bom.last.used.bom.tree</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="colors">grey: obsolete == True</attribute>
                </xpath>
                <field name="name" position="after">
                    <field name="obsolete" />
                </field>
            </field>
        </record>
        <!--Wizard:-->
        <!--bom.product.alternative.wizard-->
        <record model="ir.ui.view" id="view_bom_product_alternative_list_tree">
            <field name="name">product.product.tree</field>
            <field name="model">product.product</field>
            <field name="arch" type="xml">
                <tree string="Alternative">
                    <field name="default_code" readonly="1"/>
                    <field name="name" readonly="1"/>
                    <field name="accounting_qty" readonly="1"/>
                    <button type="object"  name="select_this_product_button" string="Seleziona questo" icon="terp-stock_effects-object-colorize"/>
                </tree>
            </field>
        </record>

        <!-- Objects:-->
        <!-- Inherit: mrp.bom -->
        <record model="ir.ui.view" id="view_mrp_bom_button_alternative_form">
            <field name="name">mrp.bom.button.alternative.custom.form</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <!-- Custom BOM: -->
                <field name="name" position="after">
                    <field name="obsolete" attribute="{'invisible': [('mrp_id', '=', False)]}" />
                </field>

                <xpath expr="//field[@name='routing_id']" position="after">
                    <!--<newline/>
                    <label for="mrp_id" attribute="{'invisible': [('mrp_id', '=', False)]}"/>-->
                    <field name="mrp_id" invisible="1" /><!--attribute="{'invisible': [('mrp_id', '=', False)]}"-->
                </xpath>
                <!--<label for="routing_id" position="attributes">
                    <attribute name="invisible">1</attribute>
                </label>-->
                <!--<xpath expr="//field[@name='routing_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>-->

                <!-- Hide part if MRP BOM: -->
                <!--<xpath expr="//field[@name='obsolete']" position="attributes">
                    <attribute name="attrs">{'invisible': [('mrp_id', '!=', False)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='is_primary']" position="attributes">
                    <attribute name="attrs">{'invisible': [('mrp_id', '!=', False)]}</attribute>
                </xpath>-->
                <xpath expr="//field[@name='type']" position="attributes">
                    <attribute name="attrs">{'invisible': [('mrp_id', '!=', False)]}</attribute>
                </xpath>
                <!--
                <xpath expr="//field[@name='from_bom_id']" position="attributes">
                    <attribute name="attrs">{'invisible': [('mrp_id', '!=', False)]}</attribute>
                </xpath>
                -->
                <xpath expr="//field[@name='code']" position="attributes">
                    <attribute name="attrs">{'invisible': [('mrp_id', '!=', False)]}</attribute>
                </xpath>
                <!-- Distinte derivate -->
                <!--<xpath expr="//notebook/page[2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>-->

                <xpath expr="//field[@name='bom_lines']//field[@name='product_uom']" position="attributes">
                    <attribute name="string">U.M.</attribute>
                </xpath>
                <xpath expr="//field[@name='bom_lines']//field[@name='date_start']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='bom_lines']//field[@name='date_stop']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>


                <!-- Extra fields line:-->
                <!--<xpath expr="//field[@name='bom_lines']" position="attributes">
                    <attribute name="context">{'mrp_id': mrp_id}</attribute>
                </xpath>-->
                <xpath expr="//field[@name='bom_lines']//field[@name='product_id']" position="before">
                    <field name="base_product_id" readonly="1" invisible="not context.get('origin_bom_id')"/><!--attrs="{'invisible': [('parent.mrp_id', '!=', False)]}"-->
                    <field name="base_product_qty" readonly="1" invisible="not context.get('origin_bom_id')"/>
                </xpath>

                <!--<xpath expr="//field[@name='bom_lines']//field[@name='product_id']" position="after">
                    <field name="origin_id"/>
                </xpath>-->

                <!-- Alternative component: -->
                <xpath expr="//field[@name='bom_lines']//field[@name='product_id']" position="after">
                    <button type="object"
                            name="choose_material_alternative"
                            string="Seleziona prodotto alternativo"
                            icon="terp-stock_effects-object-colorize"
                            />
                </xpath>
            </field>
        </record>

        <!--bom.product.alternative-->
        <record model="ir.ui.view" id="view_bom_product_alternative_form">
            <field name="name">bom.product.alternative.form</field>
            <field name="model">bom.product.alternative</field>
            <field name="arch" type="xml">
                <form string="Alternative" version="7.0">
                    <sheet>
                        <group col="4">
                            <field name="name" />
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="view_bom_product_alternative_tree">
            <field name="name">bom.product.alternative.tree</field>
            <field name="model">bom.product.alternative</field>
            <field name="arch" type="xml">
                <tree string="Alternative" editable="bottom">
                    <field name="name" />
                    <field name="group_ids" widget="many2many_tags" options="{'create': true, 'create_edit': true}"/>
                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="view_bom_product_alternative_search">
            <field name="name">bom.product.alternative.search</field>
            <field name="model">bom.product.alternative</field>
            <field name="arch" type="xml">
                <search string="Alternative" version="7.0">
                    <field name="name" />
                    <!--<field name="partner_id" filter_domain="[('partner_id','=',self)]"/>
                    <filter name="state_draft" string="Draft state" domain="[('state','=','draft')]"/>
                    <group expand="0" string="Group By...">
                        <filter string="Status" context="{'group_by': 'state'}" />
                    </group>-->
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_bom_product_alternative">
            <field name="name">Alternative prodotti (DB)</field>
            <field name="res_model">bom.product.alternative</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_bom_product_alternative_tree"/>
            <field name="context">{'form_view_ref': 'production_line.view_bom_product_alternative_form'}</field>
            <field name="domain">[]</field>
        </record>
        <menuitem
            id="menu_bom_product_alternative"
            name="Alternative DB"
            parent="mrp.menu_mrp_bom_form_action"
            sequence="100" groups="group_production_admin,group_production_logistic,group_production_stock"
            action="action_bom_product_alternative"/>
   </data>
</openerp>
